# Backend Staging Environment Variables
# Copy this file to .env.staging and update with actual staging values

# Database Configuration
DB_HOST=staging-db.example.com
DB_PORT=5432
DB_USERNAME=graduatematch_staging
DB_PASSWORD=staging_secure_password
DB_NAME=graduatematch_staging

# JWT Configuration
JWT_SECRET=staging_jwt_secret_key
JWT_EXPIRES_IN=7d

# Application Configuration
NODE_ENV=staging
LOG_LEVEL=info
API_PORT=3001

# Frontend URL
FRONTEND_URL=https://staging.graduatematch.com

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=staging@graduatematch.com
MAIL_PASSWORD=staging_app_password
MAIL_FROM=noreply@staging.graduatematch.com
