# ===========================================
# GraduateMatch Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Application Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DATABASE_URL=postgresql://graduatematch:your_password@localhost:5432/graduatematch_dev
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=graduatematch
DB_PASSWORD=your_password_here
DB_NAME=graduatematch_dev
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=2000

# JWT Configuration (CHANGE IN PRODUCTION!)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Redis (Optional)
REDIS_URL=redis://localhost:6379

# Email Configuration (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=noreply@graduatematch.com
