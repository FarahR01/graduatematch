# ===========================================
# GraduateMatch Docker Ignore
# ===========================================

# Dependencies (will be installed in container)
**/node_modules
node_modules

# Build outputs (rebuilt in container)
**/dist
**/build
**/.next
**/.turbo

# Development files
*.log
**/*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Git
.git
.gitignore
.gitattributes
**/.git

# IDE / Editor
.idea
.vscode
**/*.swp
**/*.swo
**/*~
.editorconfig

# Test files
**/coverage
**/*.spec.ts
**/*.test.ts
**/__tests__
**/test
**/*.spec.js
**/*.test.js

# Docker files (prevent recursion)
**/Dockerfile*
**/docker-compose*
**/.docker
.dockerignore

# Documentation (not needed in runtime)
**/*.md
!README.md
**/docs
**/*.txt
LICENSE

# Environment files (secrets - inject at runtime)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# OS files
**/.DS_Store
**/Thumbs.db
**/desktop.ini

# Temporary files
**/tmp
**/temp
**/*.tmp
**/*.temp

# Cache directories
**/.cache
**/.npm
**/.pnpm-store
**/.yarn

# Misc build artifacts
**/*.tgz
**/*.tar.gz
**/*.zip

# Frontend specific (if not building frontend)
apps/web/.next
apps/docs/.next

# Scripts that aren't needed in production
**/scripts/backup.sh
**/scripts/restore.sh

# Turborepo cache
.turbo
**/.turbo
