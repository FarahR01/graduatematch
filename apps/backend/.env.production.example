# Backend Production Environment Variables
# Copy this file to .env.production and update with actual production values
# NEVER commit this file to version control!

# Database Configuration
DB_HOST=prod-db.example.com
DB_PORT=5432
DB_USERNAME=graduatematch_prod
DB_PASSWORD=production_secure_password
DB_NAME=graduatematch_production

# JWT Configuration
JWT_SECRET=production_jwt_secret_key
JWT_EXPIRES_IN=7d

# Application Configuration
NODE_ENV=production
LOG_LEVEL=error
API_PORT=3001

# Frontend URL
FRONTEND_URL=https://graduatematch.com

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=noreply@graduatematch.com
MAIL_PASSWORD=production_app_password
MAIL_FROM=noreply@graduatematch.com
